<?xml version="1.0" encoding="UTF-8"?>
<!--
  searchDataXray workflow
  =======================
  Create a Data X-Ray search query from Collibra classifications, then
  optionally import every matching file as a Collibra asset:
    startEvent (form: searchDataXrayForm — rendered as the + Create dialog)
      → searchDataXrayTask (script)
      → resultsTask (user form: searchResultsForm — results + "import?" decision)
      → decideImportGateway
          ├─ importDecision unticked → endEvent
          └─ importDecision ticked   → importCollectorTask (script, sync:
                 re-runs the query, builds the batched work list)
              → importBatchTask (script, ASYNC: one batch of 50 assets per
                 execution/transaction — Collibra's bulk-operations pattern)
              → moreWorkGateway ─ ${hasMoreWork} ─→ back to importBatchTask
              → importSummaryTask (user form: importSummaryForm)
              → endEventImported

  The input form is attached to the start event so Collibra renders it as the
  modal dialog when the workflow is launched from the global + Create button.
  The results form is a userTask because Flowable has no native post-completion
  modal — the inbox task is the standard way to surface per-run results.

  All connection/UUID configuration lives on the start event as non-readable
  formProperty entries (hidden admin settings edited on the workflow settings
  page). They do not appear on the start dialog. Each carries a non-empty
  default because Collibra rejects empty defaults on non-readable properties;
  secrets that have no sensible default ship a "<paste … here>" sentinel that
  the script detects as "unset".

  Script placeholders of the form {script:filename.groovy} are resolved by
  deploy.py before the BPMN is packaged.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:design="http://flowable.org/design"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.collibra.com/apiv2"
             exporter="Flowable Design"
             exporterVersion="2025.1.09"
             design:palette="flowable-core-process-palette">

  <process id="searchDataXray"
           name="Search Data X-Ray"
           isExecutable="true"
           flowable:candidateStarterGroups="flowableUser">
    <documentation>Create a Data X-Ray search query from Collibra classifications and preview the matching files.</documentation>
    <extensionElements>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
    </extensionElements>

    <startEvent id="startEvent" name="Start" flowable:initiator="initiator" flowable:formKey="searchDataXrayForm">
      <extensionElements>
        <flowable:formProperty id="dataxrayUrl" name="Data X-Ray Base URL" type="string" variable="dataxrayUrl" default="&lt;paste Data X-Ray base URL here&gt;" readable="false" required="true"/>
        <flowable:formProperty id="dataxrayAuthToken" name="Data X-Ray Auth Token (Bearer)" type="string" variable="dataxrayAuthToken" default="&lt;paste Data X-Ray Bearer token here&gt;" readable="false" required="true"/>

        <design:stencilid><![CDATA[StartNoneEvent]]></design:stencilid>
      </extensionElements>
    </startEvent>

    <scriptTask id="searchDataXrayTask"
                name="Search Data X-Ray"
                scriptFormat="groovy"
                flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:search_data_xray.groovy}}</script>
    </scriptTask>

    <userTask id="resultsTask"
              name="Search Results"
              flowable:candidateUsers="user(${initiator})"
              flowable:formKey="searchResultsForm">
      <extensionElements>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
      </extensionElements>
    </userTask>

    <!-- Import path: user ticked "import" on the results form. -->
    <exclusiveGateway id="decideImportGateway" name="Import assets?" default="flowSkipImport">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>

    <scriptTask id="importCollectorTask"
                name="Collect Import Work List"
                scriptFormat="groovy"
                flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:import_collector.groovy}}</script>
    </scriptTask>

    <!-- ASYNC: each execution is one transaction handling one batch of 50 —
         the exclusive gateway below loops it until the work list is drained
         (Collibra's prescribed bulk-operations shape). -->
    <scriptTask id="importBatchTask"
                name="Import File Assets (batch)"
                scriptFormat="groovy"
                flowable:async="true"
                flowable:exclusive="true"
                flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:import_batch.groovy}}</script>
    </scriptTask>

    <exclusiveGateway id="moreWorkGateway" name="More batches?" default="flowImportDone">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>

    <userTask id="importSummaryTask"
              name="Import Summary"
              flowable:candidateUsers="user(${initiator})"
              flowable:formKey="importSummaryForm">
      <extensionElements>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
      </extensionElements>
    </userTask>

    <endEvent id="endEvent" name="End">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
      </extensionElements>
    </endEvent>

    <endEvent id="endEventImported" name="End (imported)">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
      </extensionElements>
    </endEvent>

    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="searchDataXrayTask">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="searchDataXrayTask" targetRef="resultsTask">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="resultsTask" targetRef="decideImportGateway">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flowSkipImport" sourceRef="decideImportGateway" targetRef="endEvent">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flowImportYes" sourceRef="decideImportGateway" targetRef="importCollectorTask">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${importDecision == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow4" sourceRef="importCollectorTask" targetRef="importBatchTask">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow5" sourceRef="importBatchTask" targetRef="moreWorkGateway">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flowMoreWork" sourceRef="moreWorkGateway" targetRef="importBatchTask">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${hasMoreWork == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowImportDone" sourceRef="moreWorkGateway" targetRef="importSummaryTask">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow6" sourceRef="importSummaryTask" targetRef="endEventImported">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_searchDataXray">
    <bpmndi:BPMNPlane bpmnElement="searchDataXray" id="BPMNPlane_searchDataXray">

      <bpmndi:BPMNShape bpmnElement="startEvent" id="BPMNShape_startEvent">
        <omgdc:Bounds x="120" y="255" width="30" height="30"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="115" y="290" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="searchDataXrayTask" id="BPMNShape_searchDataXrayTask">
        <omgdc:Bounds x="210" y="230" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="resultsTask" id="BPMNShape_resultsTask">
        <omgdc:Bounds x="400" y="230" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="decideImportGateway" id="BPMNShape_decideImportGateway">
        <omgdc:Bounds x="570" y="250" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="545" y="215" width="90" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="endEvent" id="BPMNShape_endEvent">
        <omgdc:Bounds x="576" y="380" width="28" height="28"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="573" y="414" width="34" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="importCollectorTask" id="BPMNShape_importCollectorTask">
        <omgdc:Bounds x="670" y="230" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="importBatchTask" id="BPMNShape_importBatchTask">
        <omgdc:Bounds x="870" y="230" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="moreWorkGateway" id="BPMNShape_moreWorkGateway">
        <omgdc:Bounds x="1070" y="250" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1045" y="300" width="90" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="importSummaryTask" id="BPMNShape_importSummaryTask">
        <omgdc:Bounds x="1170" y="230" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="endEventImported" id="BPMNShape_endEventImported">
        <omgdc:Bounds x="1350" y="256" width="28" height="28"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1330" y="290" width="70" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge bpmnElement="flow1" id="BPMNEdge_flow1">
        <omgdi:waypoint x="150" y="270"/>
        <omgdi:waypoint x="210" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow2" id="BPMNEdge_flow2">
        <omgdi:waypoint x="350" y="270"/>
        <omgdi:waypoint x="400" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow3" id="BPMNEdge_flow3">
        <omgdi:waypoint x="520" y="270"/>
        <omgdi:waypoint x="570" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowSkipImport" id="BPMNEdge_flowSkipImport">
        <omgdi:waypoint x="590" y="290"/>
        <omgdi:waypoint x="590" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowImportYes" id="BPMNEdge_flowImportYes">
        <omgdi:waypoint x="610" y="270"/>
        <omgdi:waypoint x="670" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow4" id="BPMNEdge_flow4">
        <omgdi:waypoint x="810" y="270"/>
        <omgdi:waypoint x="870" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow5" id="BPMNEdge_flow5">
        <omgdi:waypoint x="1010" y="270"/>
        <omgdi:waypoint x="1070" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowMoreWork" id="BPMNEdge_flowMoreWork">
        <omgdi:waypoint x="1090" y="250"/>
        <omgdi:waypoint x="1090" y="170"/>
        <omgdi:waypoint x="940" y="170"/>
        <omgdi:waypoint x="940" y="230"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowImportDone" id="BPMNEdge_flowImportDone">
        <omgdi:waypoint x="1110" y="270"/>
        <omgdi:waypoint x="1170" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow6" id="BPMNEdge_flow6">
        <omgdi:waypoint x="1290" y="270"/>
        <omgdi:waypoint x="1350" y="270"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
