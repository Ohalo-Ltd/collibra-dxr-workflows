          "designInfo": { "stencilSuperIds": ["Output"], "stencilId": "cloud-output" },
          "label": "Search complete",
          "value": "<p>The search query <b>{{conditionName}}</b> was created and linked to your selected classifications.</p><p><b>Data X-Ray query:</b> <code>{{queryString}}</code></p><p><b>Matching files:</b> {{resultCountDisplay}}</p><p>The first {{shownCount}} match(es) are stored as a table on the search-query asset; open it to review them. Full detail is also in <code>dgc.log</code>. Click <b>Send</b> to close this task.</p>",
          "defaultValue": false,
          "size": 12,
          "ignore": false,
          "visible": true,
          "enabled": true,
          "isRequired": false,
          "id": "searchResultsSummary",
          "type": "htmlComponent"
        }
      ]
    }
  ],
  "metadata": {
    "key": "searchResultsForm",
