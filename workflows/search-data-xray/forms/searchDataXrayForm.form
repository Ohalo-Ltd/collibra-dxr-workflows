{
  "rows": [
    {
      "cols": [
        {
          "designInfo": { "stencilSuperIds": ["Output"], "stencilId": "cloud-output" },
          "label": "Search Data X-Ray",
          "value": "<p>Build a Data X-Ray search query from your Collibra classifications. Pick any combination of <b>annotators</b>, <b>extractors</b> and <b>labels</b>, optionally add a phrase to match, and give the search a name.</p><p>When you click <b>Send</b>, a search-query asset is created and linked to the classifications you chose, the matching files are fetched from Data X-Ray, and a <b>Search Results</b> task appears in your task inbox with the results.</p>",
          "defaultValue": false,
          "size": 12,
          "ignore": false,
          "visible": true,
          "enabled": true,
          "isRequired": false,
          "id": "searchDataXrayInfo",
          "type": "htmlComponent"
        }
      ]
    },
    {
      "cols": [
        {
          "designInfo": { "stencilSuperIds": ["cloud-text"], "stencilId": "cloud-text" },
          "label": "Search Query Name",
          "value": "{{conditionName}}",
          "size": 12,
          "ignore": false,
          "visible": true,
          "enabled": true,
          "isRequired": true,
          "tabIndex": 0,
          "extraSettings": { "useDelay": true, "delay": 200 },
          "id": "conditionName",
          "type": "text"
        }
      ]
    },
