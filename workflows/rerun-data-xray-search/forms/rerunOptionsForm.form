      "cols": [
        {
          "designInfo": {
            "stencilSuperIds": [
              "Output"
            ],
            "stencilId": "cloud-output"
          },
          "label": "Rerun this search",
          "value": "<p>Rerunning <b>{{conditionName}}</b>. DataXray matches <b>{{rerunResultCountDisplay}}</b> file(s) now. This search returned <b>{{rerunPreviousCountDisplay}}</b> file(s) before, so <b>{{rerunNewFilesDisplay}}</b> of today's matches are new to it.</p><p>Nothing in Collibra has changed yet. Choose what this rerun does and click <b>Send</b>. The file assets already in Collibra that the search still matches are always refreshed, and files it no longer matches are unlinked from it as usual.</p>",
          "defaultValue": false,
          "size": 12,
          "ignore": false,
          "visible": true,
          "enabled": true,
          "isRequired": false,
          "id": "rerunOptionsSummary",
          "type": "htmlComponent"
        }
      ]
    },
    {
      "cols": [
        {
          "designInfo": {
