<?xml version="1.0" encoding="UTF-8"?>
<!--
  rerunDataXraySearch workflow — Collibra Cloud + Edge variant
  ============================================================
  Same process id, form and outcome as workflow.bpmn; DataXray is reached
  through a Collibra External API task bound to an Edge HTTP connection:
    startEvent (no form — started from the query asset's page, or headlessly
                by the nightly file sync driver)
      → rerunCollectorTask (script, sync: rebuild the criteria from the asset,
           snapshot the previously returned files; interactive: arm the count probe)
      → rerunAbortedGateway ─ ${rerunAborted} ─→ retireTask (an aborted headless
           run arms no request; without this gateway the External API task fails
           on the unset ${dxrMethod} and the instance sits in error every night —
           seen on dev 29 Oct 2026 for a search whose label was deleted in DataXray)
           ─ ${headless} ─→ rerunApplyOptionsTask (the nightly follows the tags)
      → rerunCountFetchTask (External API task: 1 row, ids only) → rerunCountTask
           (script, async: total matches → the Rerun Options form's variables)
      → rerunCountGateway ─ ${hasMoreWork} ─→ back to rerunCountFetchTask (retry)
      → rerunOptionsGateway ─ ${rerunAborted} ─→ retireTask (DataXray unreachable,
           or more matches than it can page through)
      → rerunOptionsTask (user form, v2.10: how many files match now, and the
           three import options prefilled from the sync filter's tags)
      → rerunApplyOptionsTask (script, sync: write the tags, decide whether to
           create assets for new files, arm page 0 — always arms a request)
      → rerunFetchTask (External API task) → rerunPageTask (script, async:
           catalogue stages, then one results page = one batch of upserts)
      → rerunLoopGateway ─ ${hasMoreWork} ─→ back to rerunFetchTask
      → retireTask (script: unlink/retire files no longer returned — only when
           every page was fetched)
      → rerunExistsPrepareTask (script, sync: ask DataXray about the files just
           parked, or, after 0 results, about every previously returned file)
      → rerunExistsGateway ─ ${hasMoreWork} ─→ rerunExistsFetchTask (External API
           task) → rerunExistsPageTask (script, async: refresh what DataXray
           still has, flag what it has not) → rerunExistsLoopGateway ─ ${hasMoreWork}
           ─→ back to rerunExistsFetchTask
      → headlessGateway → endEvent | rerunSummaryTask (user form) → endEvent
  Headless runs never throw; every abort path records rerunAborted/rerunAbortReason.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:design="http://flowable.org/design"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.collibra.com/apiv2"
             exporter="Flowable Design"
             exporterVersion="2025.1.09"
             design:palette="flowable-core-process-palette">
  <process id="rerunDataXraySearch"
           name="Rerun DataXray Search"
           isExecutable="true"
           flowable:candidateStarterGroups="flowableUser">
    <extensionElements>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
    </extensionElements>
    <startEvent id="startEvent" name="Start" flowable:initiator="initiator">
      <extensionElements>
        <!-- No DataXray settings here (v2.11): the collector uses Search
             DataXray's (shared/dxr_config.groovy, adoptSearchDataXraySettings).
             Collibra refuses to save this definition's settings page once
             Configure has given it global start roles (workflowWrongRoles). -->
        <!-- Set to 'true' by the nightly driver via startWorkflowInstances
             formProperties; a headless run never throws and skips the summary
             user task. Admins should leave this at 'false'. -->
        <flowable:formProperty id="headless" name="Headless (set by the nightly sync — leave at false)" type="string" variable="headless" default="false" readable="false" required="false"/>
        <design:stencilid><![CDATA[StartNoneEvent]]></design:stencilid>
      </extensionElements>
    </startEvent>
    <scriptTask id="rerunCollectorTask" name="Rebuild Query" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:rerun_collector_edge.groovy}}</script>
    </scriptTask>
    <exclusiveGateway id="rerunAbortedGateway" name="Aborted? Headless?" default="flowCountFirst">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>
    <serviceTask id="rerunCountFetchTask" name="Count Matches (Edge)" flowable:async="true" flowable:exclusive="true" flowable:parallelInSameTransaction="false" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:expression><![CDATA[${dxrMethod}]]></flowable:expression></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${dxrRequestPath}]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[${dxrRequestHeaders}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[${dxrRequestBody}]]></flowable:expression></flowable:field>
        <flowable:field name="disallowRedirects"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="responseVariableName"><flowable:string><![CDATA[dxrResponseBody]]></flowable:string></flowable:field>
        <flowable:field name="resultVariablePrefix"><flowable:string><![CDATA[dxr]]></flowable:string></flowable:field>
        <flowable:field name="ignoreException"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="saveRequestVariables"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseParametersTransient"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseVariableAsJson"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <design:stencilid><![CDATA[HttpTask]]></design:stencilid>
        <design:http-connection-name><![CDATA[${dataxrayConnectionName}]]></design:http-connection-name>
      </extensionElements>
    </serviceTask>
    <scriptTask id="rerunCountTask" name="Read Match Count" scriptFormat="groovy" flowable:async="true" flowable:exclusive="true" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:rerun_count_edge.groovy}}</script>
    </scriptTask>
    <exclusiveGateway id="rerunCountGateway" name="Retry?" default="flowCountDone">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>
    <exclusiveGateway id="rerunOptionsGateway" name="Aborted?" default="flowOptions">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>
    <userTask id="rerunOptionsTask" name="Rerun Options: ${conditionName} (${dxrRunStartedAt})" flowable:candidateUsers="user(${initiator})" flowable:formKey="rerunOptionsForm">
      <extensionElements>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
      </extensionElements>
    </userTask>
    <scriptTask id="rerunApplyOptionsTask" name="Apply Rerun Options" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:rerun_apply_options_edge.groovy}}</script>
    </scriptTask>
    <serviceTask id="rerunFetchTask" name="Call DataXray (Edge)" flowable:async="true" flowable:exclusive="true" flowable:parallelInSameTransaction="false" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:expression><![CDATA[${dxrMethod}]]></flowable:expression></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${dxrRequestPath}]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[${dxrRequestHeaders}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[${dxrRequestBody}]]></flowable:expression></flowable:field>
        <flowable:field name="disallowRedirects"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="responseVariableName"><flowable:string><![CDATA[dxrResponseBody]]></flowable:string></flowable:field>
        <flowable:field name="resultVariablePrefix"><flowable:string><![CDATA[dxr]]></flowable:string></flowable:field>
        <flowable:field name="ignoreException"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="saveRequestVariables"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseParametersTransient"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseVariableAsJson"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <design:stencilid><![CDATA[HttpTask]]></design:stencilid>
        <design:http-connection-name><![CDATA[${dataxrayConnectionName}]]></design:http-connection-name>
      </extensionElements>
    </serviceTask>
    <scriptTask id="rerunPageTask" name="Sync File Assets (page)" scriptFormat="groovy" flowable:async="true" flowable:exclusive="true" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:rerun_page_edge.groovy}}</script>
    </scriptTask>
    <exclusiveGateway id="rerunLoopGateway" name="More requests?" default="flowSyncDone">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>
    <scriptTask id="retireTask" name="Retire Orphaned Files" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:retire_orphans_edge.groovy}}</script>
    </scriptTask>
    <scriptTask id="rerunExistsPrepareTask" name="Prepare DataXray Existence Check" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:rerun_exists_prepare_edge.groovy}}</script>
    </scriptTask>
    <exclusiveGateway id="rerunExistsGateway" name="Anything to check?" default="flowNothingToCheck">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>
    <serviceTask id="rerunExistsFetchTask" name="Call DataXray (Edge)" flowable:async="true" flowable:exclusive="true" flowable:parallelInSameTransaction="false" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:expression><![CDATA[${dxrMethod}]]></flowable:expression></flowable:field>
        <flowable:field name="requestUrl"><flowable:expression><![CDATA[${dxrRequestPath}]]></flowable:expression></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression><![CDATA[${dxrRequestHeaders}]]></flowable:expression></flowable:field>
        <flowable:field name="requestBody"><flowable:expression><![CDATA[${dxrRequestBody}]]></flowable:expression></flowable:field>
        <flowable:field name="disallowRedirects"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="responseVariableName"><flowable:string><![CDATA[dxrResponseBody]]></flowable:string></flowable:field>
        <flowable:field name="resultVariablePrefix"><flowable:string><![CDATA[dxr]]></flowable:string></flowable:field>
        <flowable:field name="ignoreException"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="saveRequestVariables"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string><![CDATA[true]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseParametersTransient"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <flowable:field name="saveResponseVariableAsJson"><flowable:string><![CDATA[false]]></flowable:string></flowable:field>
        <design:stencilid><![CDATA[HttpTask]]></design:stencilid>
        <design:http-connection-name><![CDATA[${dataxrayConnectionName}]]></design:http-connection-name>
      </extensionElements>
    </serviceTask>
    <scriptTask id="rerunExistsPageTask" name="Update File Statuses (batch)" scriptFormat="groovy" flowable:async="true" flowable:exclusive="true" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:rerun_exists_page_edge.groovy}}</script>
    </scriptTask>
    <exclusiveGateway id="rerunExistsLoopGateway" name="More requests?" default="flowChecksDone">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>
    <exclusiveGateway id="headlessGateway" name="Headless?" default="flowInteractive">
      <extensionElements>
        <design:stencilid><![CDATA[ExclusiveGateway]]></design:stencilid>
      </extensionElements>
    </exclusiveGateway>
    <userTask id="rerunSummaryTask" name="Rerun Summary: ${conditionName} (${dxrRunStartedAt})" flowable:candidateUsers="user(${initiator})" flowable:formKey="rerunSummaryForm">
      <extensionElements>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
      </extensionElements>
    </userTask>
    <endEvent id="endEvent" name="End">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
      </extensionElements>
    </endEvent>
    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="rerunCollectorTask"/>
    <sequenceFlow id="flow2" sourceRef="rerunCollectorTask" targetRef="rerunAbortedGateway"/>
    <sequenceFlow id="flowAborted" sourceRef="rerunAbortedGateway" targetRef="retireTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${rerunAborted == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowHeadlessNoOptions" sourceRef="rerunAbortedGateway" targetRef="rerunApplyOptionsTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${headless == 'true'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowCountFirst" sourceRef="rerunAbortedGateway" targetRef="rerunCountFetchTask"/>
    <sequenceFlow id="flowCountFetched" sourceRef="rerunCountFetchTask" targetRef="rerunCountTask"/>
    <sequenceFlow id="flowCounted" sourceRef="rerunCountTask" targetRef="rerunCountGateway"/>
    <sequenceFlow id="flowCountRetry" sourceRef="rerunCountGateway" targetRef="rerunCountFetchTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${hasMoreWork == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowCountDone" sourceRef="rerunCountGateway" targetRef="rerunOptionsGateway"/>
    <sequenceFlow id="flowCountAborted" sourceRef="rerunOptionsGateway" targetRef="retireTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${rerunAborted == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowOptions" sourceRef="rerunOptionsGateway" targetRef="rerunOptionsTask"/>
    <sequenceFlow id="flowOptionsChosen" sourceRef="rerunOptionsTask" targetRef="rerunApplyOptionsTask"/>
    <sequenceFlow id="flowFetchFirst" sourceRef="rerunApplyOptionsTask" targetRef="rerunFetchTask"/>
    <sequenceFlow id="flow3" sourceRef="rerunFetchTask" targetRef="rerunPageTask"/>
    <sequenceFlow id="flow4" sourceRef="rerunPageTask" targetRef="rerunLoopGateway"/>
    <sequenceFlow id="flowMoreWork" sourceRef="rerunLoopGateway" targetRef="rerunFetchTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${hasMoreWork == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowSyncDone" sourceRef="rerunLoopGateway" targetRef="retireTask"/>
    <sequenceFlow id="flow5" sourceRef="retireTask" targetRef="rerunExistsPrepareTask"/>
    <sequenceFlow id="flowExistsPrepared" sourceRef="rerunExistsPrepareTask" targetRef="rerunExistsGateway"/>
    <sequenceFlow id="flowCheck" sourceRef="rerunExistsGateway" targetRef="rerunExistsFetchTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${hasMoreWork == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowNothingToCheck" sourceRef="rerunExistsGateway" targetRef="headlessGateway"/>
    <sequenceFlow id="flowExistsFetched" sourceRef="rerunExistsFetchTask" targetRef="rerunExistsPageTask"/>
    <sequenceFlow id="flowExistsPaged" sourceRef="rerunExistsPageTask" targetRef="rerunExistsLoopGateway"/>
    <sequenceFlow id="flowMoreChecks" sourceRef="rerunExistsLoopGateway" targetRef="rerunExistsFetchTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${hasMoreWork == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowChecksDone" sourceRef="rerunExistsLoopGateway" targetRef="headlessGateway"/>
    <sequenceFlow id="flowHeadless" sourceRef="headlessGateway" targetRef="endEvent">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${headless == 'true'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowInteractive" sourceRef="headlessGateway" targetRef="rerunSummaryTask"/>
    <sequenceFlow id="flow6" sourceRef="rerunSummaryTask" targetRef="endEvent"/>
  </process>
