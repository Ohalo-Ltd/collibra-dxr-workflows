<?xml version="1.0" encoding="UTF-8"?>
<!--
  configureDataXrayWorkflows workflow
  ===================================
  One-time, Create-menu-triggered operating-model bootstrap, run by an admin:
    startEvent (form: confirm — rendered as a modal when triggered from Create)
      → configureTask (script)
      → resultsTask (user form: results — appears as an inbox task)
      → endEvent

  This workflow has NO configuration variables of its own. Everything it needs
  (the canonical UUIDs of the elements to create, and the process IDs of the
  workflows to configure) is baked into the script. It creates elements with
  fixed UUIDs that match the defaults already shipped in the sync/search BPMNs
  and the hardcoded UUIDs in searchDataXrayForm.form, so a fresh instance lines
  up without any form edits.

  Script placeholders of the form {script:filename.groovy} are resolved by
  deploy.py before the BPMN is packaged.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:design="http://flowable.org/design"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.collibra.com/apiv2"
             exporter="Flowable Design"
             exporterVersion="2025.1.09"
             design:palette="flowable-core-process-palette">

  <process id="configureDataXrayWorkflows"
           name="Configure Data X-Ray Workflows"
           isExecutable="true"
           flowable:candidateStarterGroups="flowableUser">
    <extensionElements>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
    </extensionElements>

    <startEvent id="startEvent" name="Start" flowable:initiator="initiator" flowable:formKey="startConfigureForm">
      <extensionElements>
        <design:stencilid><![CDATA[StartNoneEvent]]></design:stencilid>
      </extensionElements>
    </startEvent>

    <scriptTask id="configureTask"
                name="Configure Operating Model"
                scriptFormat="groovy"
                flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script>{{script:configure_data_xray.groovy}}</script>
    </scriptTask>

    <userTask id="resultsTask"
              name="Configuration Results"
              flowable:candidateUsers="user(${initiator})"
              flowable:formKey="configureResultsForm">
      <extensionElements>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
      </extensionElements>
    </userTask>

    <endEvent id="endEvent" name="End">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
      </extensionElements>
    </endEvent>

    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="configureTask">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="configureTask" targetRef="resultsTask">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="resultsTask" targetRef="endEvent">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_configureDataXrayWorkflows">
    <bpmndi:BPMNPlane bpmnElement="configureDataXrayWorkflows" id="BPMNPlane_configureDataXrayWorkflows">

      <bpmndi:BPMNShape bpmnElement="startEvent" id="BPMNShape_startEvent">
        <omgdc:Bounds x="120" y="255" width="30" height="30"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="115" y="290" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="configureTask" id="BPMNShape_configureTask">
        <omgdc:Bounds x="210" y="230" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="resultsTask" id="BPMNShape_resultsTask">
        <omgdc:Bounds x="400" y="230" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="endEvent" id="BPMNShape_endEvent">
        <omgdc:Bounds x="570" y="256" width="28" height="28"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="567" y="290" width="34" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge bpmnElement="flow1" id="BPMNEdge_flow1">
        <omgdi:waypoint x="150" y="270"/>
        <omgdi:waypoint x="210" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow2" id="BPMNEdge_flow2">
        <omgdi:waypoint x="350" y="270"/>
        <omgdi:waypoint x="400" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow3" id="BPMNEdge_flow3">
        <omgdi:waypoint x="520" y="270"/>
        <omgdi:waypoint x="570" y="270"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
